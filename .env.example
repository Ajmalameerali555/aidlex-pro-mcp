# Safe local public profile. Run scripts/configure.py to create your actual .env.
AIDLEX_ENVIRONMENT=development
AIDLEX_AUTH_MODE=public
AIDLEX_PUBLIC_BASE_URL=http://localhost:8000
AIDLEX_DATABASE_URL=sqlite:///./data/aidlex.db
AIDLEX_AUTO_MIGRATE=true
AIDLEX_DATABASE_SCHEMA=aidlex_mcp
AIDLEX_RATE_LIMIT_PER_MINUTE=120
AIDLEX_ANALYSIS_LIMIT_PER_MINUTE=3
AIDLEX_MAX_CONTEXT_CHARS=50000
AIDLEX_EMBEDDINGS_ENABLED=false
AIDLEX_EMBEDDING_MODEL=text-embedding-3-small
AIDLEX_MODEL=
AIDLEX_REASONING_EFFORT=high
AIDLEX_MODEL_TIMEOUT_SECONDS=35
AIDLEX_MODEL_MAX_OUTPUT_TOKENS=7000
AIDLEX_RESEARCH_NETWORK_ENABLED=true
AIDLEX_OAUTH_ISSUER=
AIDLEX_OAUTH_JWKS_URL=
AIDLEX_OAUTH_AUDIENCE=
AIDLEX_BEARER_TOKEN=
OPENAI_API_KEY=
