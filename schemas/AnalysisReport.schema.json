    "immediate_actions": {
      "items": {
        "type": "string"
      },
      "title": "Immediate Actions",
      "type": "array"
    },
    "unverified_legal_points": {
      "items": {
        "type": "string"
      },
      "title": "Unverified Legal Points",
      "type": "array"
    },
    "limitations": {
      "items": {
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
