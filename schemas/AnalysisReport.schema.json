{
  "$defs": {
    "Finding": {
      "additionalProperties": false,
      "properties": {
        "statement": {
          "title": "Statement",
          "type": "string"
        },
        "classification": {
          "enum": [
            "document_fact",
            "user_claim",
            "memory",
            "inference",
            "verified_source_text",
            "unconfirmed_legal_point"
          ],
          "title": "Classification",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "verification_needed": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verification Needed"
        }
      },
      "required": [
        "statement",
        "classification",
        "source_refs"
      ],
      "title": "Finding",
      "type": "object"
    },
    "Issue": {
      "additionalProperties": false,
      "properties": {
        "issue": {
          "title": "Issue",
          "type": "string"
        },
        "user_position": {
          "title": "User Position",
          "type": "string"
        },
        "opposing_position": {
          "title": "Opposing Position",
          "type": "string"
        },
        "evidence_assessment": {
          "title": "Evidence Assessment",
          "type": "string"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        },
        "verification_needed": {
          "items": {
            "type": "string"
          },
          "title": "Verification Needed",
          "type": "array"
        }
      },
      "required": [
        "issue",
        "user_position",
        "opposing_position",
        "evidence_assessment",
        "source_refs",
        "verification_needed"
      ],
      "title": "Issue",
      "type": "object"
    },
    "Route": {
      "additionalProperties": false,
      "properties": {
        "route": {
          "title": "Route",
          "type": "string"
        },
        "benefit": {
          "title": "Benefit",
          "type": "string"
        },
        "downside": {
          "title": "Downside",
          "type": "string"
        },
        "required_evidence": {
          "items": {
            "type": "string"
          },
          "title": "Required Evidence",
          "type": "array"
        },
        "procedural_checks": {
          "items": {
            "type": "string"
          },
          "title": "Procedural Checks",
          "type": "array"
        },
        "source_refs": {
          "items": {
            "type": "string"
          },
          "title": "Source Refs",
          "type": "array"
        }
      },
      "required": [
        "route",
        "benefit",
        "downside",
        "required_evidence",
        "procedural_checks",
        "source_refs"
      ],
      "title": "Route",
      "type": "object"
